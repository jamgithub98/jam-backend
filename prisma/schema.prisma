generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("child") // "parent" ya "child"
  parentId  String?  // Agar child hai toh parent ka ID store hoga
  createdAt DateTime @default(now())
  
  // Self-relation for Parent <-> Child
  parent    User?    @relation("UserParent", fields: [parentId], references: [id])
  children  User[]   @relation("UserParent")

  devices   Device[]
}

model Device {
  id             String   @id @default(uuid())
  userId         String
  deviceName     String
  androidVersion String
  battery        String
  latitude       Float?
  longitude      Float?
  status         String?  @default("online")
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
}